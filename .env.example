# ─────────────────────────────────────────────────────────────
# Base de datos (Neon Postgres)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# DATABASE_TRANSPORT: cómo se llega a Postgres.
#   tcp (default)  -> driver `pg` en el puerto 5432.
#   websocket      -> @neondatabase/serverless por WSS/443, con transacciones.
# Usá `websocket` solo cuando la red bloquee el 5432 saliente (el síntoma es un
# "Failed query" de Drizzle con un timeout TCP como causa). Producción no lo
# necesita salvo que su red también filtre el puerto.
# DATABASE_TRANSPORT=websocket

# ─────────────────────────────────────────────────────────────
# Auth (Better Auth)
# BETTER_AUTH_SECRET: obligatorio en producción. Sin él la app usa un
# secreto de desarrollo INSEGURO y las sesiones son falsificables.
# Generá uno con: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL: dejar sin definir en desarrollo. Better Auth deriva el origen
# del request; si se fija un puerto, /api/auth/* devuelve 404 cuando Vite arranca
# en otro. En producción se define por variables de entorno de la plataforma.
# BETTER_AUTH_URL=https://tu-dominio.com

# ─────────────────────────────────────────────────────────────
# Archivos (Cloudflare R2, bucket privado)
# ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=revisia

# ─────────────────────────────────────────────────────────────
# Cifrado de API keys de docentes (AES-256-GCM, F0.12)
# 32 bytes en base64: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
API_KEY_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# Proveedor de IA — opciones: openai | anthropic | google
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_MODEL=gpt-4.1-mini

# Opcional: gateway compatible con OpenAI (OpenRouter, Ollama, etc.)
# AI_BASE_URL=https://openrouter.ai/api/v1

# ─────────────────────────────────────────────────────────────
# Seed del admin inicial (scripts/seed.ts)
# ─────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@revisia.local
SEED_ADMIN_PASSWORD=cambiar-esta-clave
SEED_ADMIN_NAME=Administrador

# Opcionales: asignatura y docente de prueba
# SEED_SUBJECT_NAME=Tecnologías Avanzadas Empresariales
# SEED_SUBJECT_CODE=TAE-01
# SEED_TERM=2026-1
# SEED_TEACHER_EMAIL=docente@revisia.local
# SEED_TEACHER_NAME=Docente
