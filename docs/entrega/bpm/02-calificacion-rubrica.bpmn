<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Calificacion"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Calificacion" name="P2 - Calificación por rúbrica, individual y masiva" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Calificacion">
      <bpmn:lane id="Lane_Docente_C" name="Docente">
        <bpmn:flowNodeRef>StartEvent_Calif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AbrirActividad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Rubrica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AsignarRubrica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Modo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Revisar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema_C" name="Sistema RevisIA">
        <bpmn:flowNodeRef>Task_ArmarPrompt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalificarLLM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Normalizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Persistir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Pendientes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Exportar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Calif</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Calif" name="Entregas procesadas">
      <bpmn:outgoing>CFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_AbrirActividad" name="Abrir la actividad">
      <bpmn:incoming>CFlow_01</bpmn:incoming>
      <bpmn:outgoing>CFlow_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Rubrica" name="¿Tiene rúbrica asignada?" default="CFlow_04">
      <bpmn:incoming>CFlow_02</bpmn:incoming>
      <bpmn:incoming>CFlow_05</bpmn:incoming>
      <bpmn:outgoing>CFlow_03</bpmn:outgoing>
      <bpmn:outgoing>CFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_AsignarRubrica" name="Asignar rúbrica en el editor">
      <bpmn:incoming>CFlow_04</bpmn:incoming>
      <bpmn:outgoing>CFlow_05</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Modo" name="¿Individual o lote?">
      <bpmn:incoming>CFlow_03</bpmn:incoming>
      <bpmn:incoming>CFlow_05</bpmn:incoming>
      <bpmn:outgoing>CFlow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_ArmarPrompt" name="Armar prompt con contexto y rúbrica">
      <bpmn:incoming>CFlow_06</bpmn:incoming>
      <bpmn:incoming>CFlow_11</bpmn:incoming>
      <bpmn:outgoing>CFlow_07</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CalificarLLM" name="Calificar con el modelo de lenguaje">
      <bpmn:incoming>CFlow_07</bpmn:incoming>
      <bpmn:outgoing>CFlow_08</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Normalizar" name="Normalizar y recalcular el total">
      <bpmn:incoming>CFlow_08</bpmn:incoming>
      <bpmn:outgoing>CFlow_09</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Persistir" name="Persistir nota por criterio">
      <bpmn:incoming>CFlow_09</bpmn:incoming>
      <bpmn:outgoing>CFlow_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Pendientes" name="¿Quedan entregas pendientes?">
      <bpmn:incoming>CFlow_10</bpmn:incoming>
      <bpmn:outgoing>CFlow_11</bpmn:outgoing>
      <bpmn:outgoing>CFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Revisar" name="Revisar retroalimentación">
      <bpmn:incoming>CFlow_12</bpmn:incoming>
      <bpmn:outgoing>CFlow_13</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Exportar" name="Exportar a Excel">
      <bpmn:incoming>CFlow_13</bpmn:incoming>
      <bpmn:outgoing>CFlow_14</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Calif" name="Notas registradas y exportadas">
      <bpmn:incoming>CFlow_14</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="CFlow_01" sourceRef="StartEvent_Calif" targetRef="Task_AbrirActividad" />
    <bpmn:sequenceFlow id="CFlow_02" sourceRef="Task_AbrirActividad" targetRef="Gateway_Rubrica" />
    <bpmn:sequenceFlow id="CFlow_03" name="Sí" sourceRef="Gateway_Rubrica" targetRef="Gateway_Modo" />
    <bpmn:sequenceFlow id="CFlow_04" name="No" sourceRef="Gateway_Rubrica" targetRef="Task_AsignarRubrica" />
    <bpmn:sequenceFlow id="CFlow_05" sourceRef="Task_AsignarRubrica" targetRef="Gateway_Modo" />
    <bpmn:sequenceFlow id="CFlow_06" sourceRef="Gateway_Modo" targetRef="Task_ArmarPrompt" />
    <bpmn:sequenceFlow id="CFlow_07" sourceRef="Task_ArmarPrompt" targetRef="Task_CalificarLLM" />
    <bpmn:sequenceFlow id="CFlow_08" sourceRef="Task_CalificarLLM" targetRef="Task_Normalizar" />
    <bpmn:sequenceFlow id="CFlow_09" sourceRef="Task_Normalizar" targetRef="Task_Persistir" />
    <bpmn:sequenceFlow id="CFlow_10" sourceRef="Task_Persistir" targetRef="Gateway_Pendientes" />
    <bpmn:sequenceFlow id="CFlow_11" name="Sí" sourceRef="Gateway_Pendientes" targetRef="Task_ArmarPrompt" />
    <bpmn:sequenceFlow id="CFlow_12" name="No" sourceRef="Gateway_Pendientes" targetRef="Task_Revisar" />
    <bpmn:sequenceFlow id="CFlow_13" sourceRef="Task_Revisar" targetRef="Task_Exportar" />
    <bpmn:sequenceFlow id="CFlow_14" sourceRef="Task_Exportar" targetRef="EndEvent_Calif" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Calificacion">
    <bpmndi:BPMNPlane id="BPMNPlane_Calificacion" bpmnElement="Process_Calificacion">
      <bpmndi:BPMNShape id="Lane_Docente_C_di" bpmnElement="Lane_Docente_C" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1960" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistema_C_di" bpmnElement="Lane_Sistema_C" isHorizontal="true">
        <dc:Bounds x="160" y="300" width="1960" height="180" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Calif_di" bpmnElement="StartEvent_Calif">
        <dc:Bounds x="200" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="180" y="175" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AbrirActividad_di" bpmnElement="Task_AbrirActividad">
        <dc:Bounds x="270" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Rubrica_di" bpmnElement="Gateway_Rubrica" isMarkerVisible="true">
        <dc:Bounds x="450" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="424" y="182" width="102" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AsignarRubrica_di" bpmnElement="Task_AsignarRubrica">
        <dc:Bounds x="430" y="215" width="150" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Modo_di" bpmnElement="Gateway_Modo" isMarkerVisible="true">
        <dc:Bounds x="610" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="588" y="182" width="94" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ArmarPrompt_di" bpmnElement="Task_ArmarPrompt">
        <dc:Bounds x="700" y="355" width="150" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CalificarLLM_di" bpmnElement="Task_CalificarLLM">
        <dc:Bounds x="880" y="355" width="150" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Normalizar_di" bpmnElement="Task_Normalizar">
        <dc:Bounds x="1060" y="355" width="150" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Persistir_di" bpmnElement="Task_Persistir">
        <dc:Bounds x="1240" y="355" width="150" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Pendientes_di" bpmnElement="Gateway_Pendientes" isMarkerVisible="true">
        <dc:Bounds x="1420" y="365" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1394" y="422" width="104" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Revisar_di" bpmnElement="Task_Revisar">
        <dc:Bounds x="1530" y="110" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Exportar_di" bpmnElement="Task_Exportar">
        <dc:Bounds x="1740" y="355" width="150" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Calif_di" bpmnElement="EndEvent_Calif">
        <dc:Bounds x="1950" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1917" y="415" width="102" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="CFlow_01_di" bpmnElement="CFlow_01">
        <di:waypoint x="236" y="150" />
        <di:waypoint x="270" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_02_di" bpmnElement="CFlow_02">
        <di:waypoint x="410" y="150" />
        <di:waypoint x="450" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_03_di" bpmnElement="CFlow_03">
        <di:waypoint x="500" y="150" />
        <di:waypoint x="610" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_04_di" bpmnElement="CFlow_04">
        <di:waypoint x="475" y="175" />
        <di:waypoint x="475" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_05_di" bpmnElement="CFlow_05">
        <di:waypoint x="580" y="250" />
        <di:waypoint x="635" y="250" />
        <di:waypoint x="635" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_06_di" bpmnElement="CFlow_06">
        <di:waypoint x="660" y="150" />
        <di:waypoint x="680" y="150" />
        <di:waypoint x="680" y="390" />
        <di:waypoint x="700" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_07_di" bpmnElement="CFlow_07">
        <di:waypoint x="850" y="390" />
        <di:waypoint x="880" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_08_di" bpmnElement="CFlow_08">
        <di:waypoint x="1030" y="390" />
        <di:waypoint x="1060" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_09_di" bpmnElement="CFlow_09">
        <di:waypoint x="1210" y="390" />
        <di:waypoint x="1240" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_10_di" bpmnElement="CFlow_10">
        <di:waypoint x="1390" y="390" />
        <di:waypoint x="1420" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_11_di" bpmnElement="CFlow_11">
        <di:waypoint x="1445" y="415" />
        <di:waypoint x="1445" y="465" />
        <di:waypoint x="775" y="465" />
        <di:waypoint x="775" y="425" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_12_di" bpmnElement="CFlow_12">
        <di:waypoint x="1470" y="390" />
        <di:waypoint x="1605" y="390" />
        <di:waypoint x="1605" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_13_di" bpmnElement="CFlow_13">
        <di:waypoint x="1680" y="150" />
        <di:waypoint x="1700" y="150" />
        <di:waypoint x="1700" y="390" />
        <di:waypoint x="1740" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CFlow_14_di" bpmnElement="CFlow_14">
        <di:waypoint x="1890" y="390" />
        <di:waypoint x="1950" y="390" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
