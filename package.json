{
	"name": "my-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx -r dotenv/config scripts/seed.ts",
		"fixtures:f2": "tsx scripts/generar-entregas-prueba.ts",
		"cors:apply": "node scripts/set-filebase-cors.mjs"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.16",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/yauzl": "^3.4.0",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.11",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vite-node": "^6.0.0",
		"vitest": "^5.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1165.0",
		"@aws-sdk/s3-request-presigner": "^3.1165.0",
		"@better-auth/drizzle-adapter": "^1.7.18",
		"@neon/config": "^1.14.0",
		"@neon/env": "^2.1.3",
		"@neondatabase/serverless": "^1.2.1",
		"@types/exceljs": "^1.3.2",
		"better-auth": "^1.7.18",
		"dotenv": "^18.0.10",
		"drizzle-orm": "^0.45.4",
		"exceljs": "^4.4.0",
		"mammoth": "^1.13.0",
		"pg": "^8.23.1",
		"unpdf": "^2.1.0",
		"yauzl": "^3.4.0"
	}
}
